# AWS Guardian - Production Environment Variables
# ⚠️  IMPORTANT: Never commit actual credentials to git!
# Use AWS Secrets Manager or Parameter Store for production

# ============================================================================
# AWS Configuration (use IAM roles in production, not hardcoded credentials)
# ============================================================================
# In production Lambda: Use execution role
# In production EC2/ECS: Use instance/task role
# Local development: Set via environment or .env file

AWS_REGION=us-east-1
AWS_PROFILE=production

# ⚠️  For production, these should be injected via:
#     - IAM Roles (Lambda, EC2, ECS)
#     - AWS Secrets Manager
#     - Parameter Store
# DO NOT commit real credentials
AWS_ACCESS_KEY_ID=<from-aws-secrets-manager>
AWS_SECRET_ACCESS_KEY=<from-aws-secrets-manager>

# ============================================================================
# Telegram Configuration (from Secrets Manager)
# ============================================================================
TELEGRAM_BOT_TOKEN=<from-aws-secrets-manager>
TELEGRAM_CHAT_ID=<from-aws-secrets-manager>

# ============================================================================
# Discord Configuration (from Secrets Manager)
# ============================================================================
DISCORD_WEBHOOK_URL=<from-aws-secrets-manager>
DISCORD_PUBLIC_KEY=<from-aws-secrets-manager>
DISCORD_BOT_TOKEN=<from-aws-secrets-manager>

# ============================================================================
# Cost Threshold
# ============================================================================
# Production: Set to your actual business limit
COST_THRESHOLD=100.0

# ============================================================================
# LocalStack Configuration (for testing only)
# ============================================================================
# Production: Should not use LocalStack; use actual AWS services
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_AUTH_TOKEN=<optional-for-cloud-localstack>

# ============================================================================
# Application Configuration
# ============================================================================
# Enable structured JSON logging
LOG_FORMAT=json

# CloudWatch Logs group (for Lambda)
LOG_GROUP=/aws/lambda/aws-guardian

# DynamoDB table names
DYNAMODB_TABLE=guardian_events
DYNAMODB_RESPONSES_TABLE=auto_responses

# Terraform outputs (set during deployment)
TERRAFORM_OUTPUT_VERSION=v1.0

# ============================================================================
# Security Settings
# ============================================================================
# Disable debug logging in production
DEBUG=false

# Enable CloudWatch monitoring
ENABLE_CLOUDWATCH=true

# Enable X-Ray tracing
ENABLE_XRAY_TRACING=true

# ============================================================================
# Deployment Information (auto-set by deployment scripts)
# ============================================================================
DEPLOYMENT_ENV=production
DEPLOYMENT_DATE=<set-by-ci-cd>
DEPLOYMENT_VERSION=<set-by-ci-cd>
GIT_COMMIT_SHA=<set-by-ci-cd>
