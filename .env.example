# AWS Guardian - Local Development Environment Variables
# ============================================================================
# 📋 Usage:
#   cp .env.example .env
#   Edit .env with your actual values
#   docker-compose up -d
#
# 🔒 Security: .env is in .gitignore - never commit credentials
# ============================================================================

# ============================================================================
# AWS Configuration (Local Development)
# ============================================================================
# Use LocalStack credentials (not real AWS)
AWS_REGION=us-east-1
AWS_PROFILE=default

# LocalStack uses fixed test credentials for local development
# ⚠️  NEVER use these credentials in production!
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============================================================================
# Telegram Configuration (Local Testing)
# ============================================================================
# Get your token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# Discord Configuration (Local Testing)
# ============================================================================
# Webhook URL from: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Public Key from: Discord Developer Portal → General Information
DISCORD_PUBLIC_KEY=your_discord_public_key_here

# Bot Token from: Discord Developer Portal → Bot → TOKEN
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================================================
# Cost Threshold (in USD per day)
# ============================================================================
# For local testing: Use low threshold (e.g., 5.0) to test alerts
COST_THRESHOLD=10.0

# ============================================================================
# LocalStack Configuration (for Docker Compose)
# ============================================================================
# LocalStack endpoint (configured in docker-compose.yml)
LOCALSTACK_ENDPOINT=http://localhost:4566

# LocalStack Auth Token (optional, for hosted LocalStack)
# For local Docker: Leave empty or use any value
LOCALSTACK_AUTH_TOKEN=

# ============================================================================
# Application Configuration (Local Development)
# ============================================================================
# Enable debug logging for development
DEBUG=1

# Log format: "plain" or "json"
LOG_FORMAT=plain

# DynamoDB configuration
DYNAMODB_TABLE=guardian_events
DYNAMODB_RESPONSES_TABLE=auto_responses

# ============================================================================
# Optional: Development Tools
# ============================================================================
# LocalStack Dashboard: http://localhost:4566/#!/
# DynamoDB Admin UI: npm install -g dynamodb-admin
#   DYNAMODB_ENDPOINT=http://localhost:8000 dynamodb-admin
